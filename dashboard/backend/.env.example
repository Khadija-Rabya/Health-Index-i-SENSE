# Modele du fichier .env — a copier en .env (jamais commite) puis a completer.
# En production (Render, Railway...), definir ces memes variables dans
# l'interface de l'hebergeur plutot que dans un fichier.

# ---- Connexion a l'API i-SENSE ----
ISENSE_LIVE=1
ISENSE_API_URL=https://v3back-demo.i-sense.io/api/i-sense-v3
ISENSE_EMAIL=
ISENSE_PASSWORD=
ISENSE_JOURS_AMORCE=3

# ---- Compte de connexion au tableau de bord ----
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Generer : python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
AUTH_TTL_H=12

# ---- Serveur ----
PERIODE_CALCUL_S=600
# En production : l'adresse exacte du frontend, ex. https://mon-dashboard.vercel.app
CORS_ORIGINS=*
DASHBOARD_URL=http://localhost:5173
